# Load these as environment variables; app also reads a local .env when present.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=schemaguard_demo
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=
# FALKORDB_SSL=true  # Cloud or any secure remote Redis endpoint
# OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible API endpoint (only use a trusted provider)
# OPENAI_BASE_URL=
